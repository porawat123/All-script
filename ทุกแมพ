local function createMenuRow(labelText, boxText, posY, boxColor, textColor)
    local label = Instance.new("TextLabel")
    label.Parent = MainFrame
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0.07, 0, 0, posY)
    label.Size = UDim2.new(0.35, 0, 0, 40)
    label.Font = Enum.Font.FredokaOne
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(60, 60, 65) -- สีตัวหนังสือป้ายข้างใช้สีเข้มขึ้นเพื่อให้ตัดกับพื้นหลังครีม
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left

    local box = Instance.new("TextButton")
    box.Parent = MainFrame
    box.BackgroundColor3 = boxColor
    box.Position = UDim2.new(0.45, 0, 0, posY)
    box.Size = UDim2.new(0.48, 0, 0, 40)
    box.Font = Enum.Font.FredokaOne
    box.Text = boxText
    box.TextColor3 = textColor
    box.TextSize = 14
    
    local BoxCorner = UICorner:Clone()
    BoxCorner.CornerRadius = UDim.new(0, 10)
    BoxCorner.Parent = box
    
    return box
end

