-- [[ 3. ระบบฟังก์ชันกลาง (Universal Functions) ]] --
local player = game.Players.LocalPlayer
local speedToggle = false
local jumpToggle = false
local brightToggle = false

-- ฟังก์ชันปรับแต่งสถานะปุ่มเมื่อกดเปิด (จะเปลี่ยนเป็นสีเขียวมินต์สดใสสะดุดตา)
local function updateButtonVisual(btn, state, onText, offText, defaultColor, defaultTextColor)
    if state then
        btn.BackgroundColor3 = Color3.fromRGB(50, 205, 50) -- สีเขียวมะนาว/มินต์ สดใสมากเวลาเปิด
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = onText
    else
        btn.BackgroundColor3 = defaultColor -- กลับเป็นสีพาสเทลหวานๆ ตอนปิด
        btn.TextColor3 = defaultTextColor
        btn.Text = offText
    end
end

-- 1. ฟังก์ชันวิ่งไว
SpeedRow.MouseButton1Click:Connect(function()
    speedToggle = not speedToggle
    updateButtonVisual(SpeedRow, speedToggle, "เปิดอยู่ (วิ่งไวคูณสอง)", "ปิดอยู่ (สปีดปกติ)", Color3.fromRGB(174, 219, 242), Color3.fromRGB(40, 70, 90))
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = speedToggle and 50 or 16
    end
end)

-- 2. ฟังก์ชันกระโดดสูง
JumpRow.MouseButton1Click:Connect(function()
    jumpToggle = not jumpToggle
    updateButtonVisual(JumpRow, jumpToggle, "เปิดอยู่ (โดดสูงพิเศษ)", "ปิดอยู่ (โดดปกติ)", Color3.fromRGB(255, 182, 193), Color3.fromRGB(90, 40, 50))
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.JumpPower = jumpToggle and 100 or 50
    end
end)

-- 3. ฟังก์ชันเปิดไฟแมพ
BrightRow.MouseButton1Click:Connect(function()
    brightToggle = not brightToggle
    updateButtonVisual(BrightRow, brightToggle, "เปิดอยู่ (สว่างจ้า)", "ปิดอยู่ (มืดตามแมพ)", Color3.fromRGB(255, 236, 139), Color3.fromRGB(80, 70, 20))
    if brightToggle then
        game:GetService("Lighting").Brightness = 2
        game:GetService("Lighting").ClockTime = 14
        game:GetService("Lighting").Ambient = Color3.fromRGB(255, 255, 255)
    else
        game:GetService("Lighting").Brightness = 1
    end
end)

-- [[ 4. ระบบล็อกค่าอัตโนมัติเมื่อเกิดใหม่ ]] --
player.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid")
    task.wait(0.6)
    if speedToggle then hum.WalkSpeed = 50 end
    if jumpToggle then hum.JumpPower = 100 end
end)
